{
  "name": "angular-hnpwa",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox --code-coverage",
    "lint": "ng lint",
    "lint:report": "mkdir -p reports && ng lint --format json --force | grep -E '^\\[' > reports/eslint-report.json",
    "e2e": "playwright test",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit || true",
    "snyk:deps": "snyk test --severity-threshold=high",
    "snyk:code": "snyk code test --severity-threshold=high",
    "sonar": "sonar-scanner",
    "verify": "npm run lint && npm run test:ci && npm run build -- --configuration production && npm run e2e"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.30",
    "@angular/common": "^20.3.30",
    "@angular/compiler": "^20.3.30",
    "@angular/core": "^20.3.30",
    "@angular/forms": "^20.3.30",
    "@angular/platform-browser": "^20.3.30",
    "@angular/router": "^20.3.30",
    "@angular/service-worker": "^20.3.30",
    "rxjs": "~7.8.0",
    "tslib": "^2.0.0",
    "unfetch": "^4.1.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "20.7.0",
    "@angular-eslint/eslint-plugin": "20.7.0",
    "@angular-eslint/eslint-plugin-template": "20.7.0",
    "@angular-eslint/schematics": "20.7.0",
    "@angular-eslint/template-parser": "20.7.0",
    "@angular/build": "^20.3.35",
    "@angular/cli": "^20.3.35",
    "@angular/compiler-cli": "^20.3.30",
    "@angular/language-service": "^20.3.30",
    "@playwright/test": "^1.62.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.20.1",
    "@types/node-fetch": "^2.6.13",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^8.57.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "typescript": "~5.8.3"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 4,
    "singleQuote": true,
    "printWidth": 120
  }
}
